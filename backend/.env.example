# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Configuration (for CORS origin resolution)
# Set to the deployment origin of your frontend (e.g., https://your-app.vercel.app)
# You can use a comma-separated list for multiple domains.
FRONTEND_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL Connection Pooling via PgBouncer)
DATABASE_URL="postgresql://username:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# Direct connection to the database (Supabase PostgreSQL Direct connection on port 5432 - required for migrations)
DIRECT_URL="postgresql://username:password@db.supabase.co:5432/postgres"

# Authentication Config
# In production, change this to a secure, unique, and long random string
JWT_SECRET=your_jwt_secret_must_be_changed_in_production
JWT_EXPIRES_IN=7d

# File Upload configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Retrieval Diagnostics & Diversity
RETRIEVAL_SCORE_THRESHOLD=0.20
MAX_CHUNKS_PER_DOC=2

