generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         UserRole      @default(ADMISSION_OFFICER)
  status       String        @default("Active")
  lastLogin    DateTime?
  avatar       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatSessions ChatSession[]
  leads        Lead[]

  @@map("users")
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  phone        String
  email        String
  course       String
  status       LeadStatus @default(NEW)
  source       LeadSource
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assignedTo   String?    @map("assigned_to")
  assignedUser User?      @relation(fields: [assignedTo], references: [id], map: "leads_assignedTo_fkey")

  @@map("leads")
}

model ChatSession {
  id             String        @id @default(cuid())
  studentName    String
  courseInterest String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  agentId        String?
  messages       ChatMessage[]
  agent          User?         @relation(fields: [agentId], references: [id])

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Document {
  id         String          @id @default(cuid())
  name       String
  size       Int
  mimeType   String
  filePath   String
  status     DocumentStatus  @default(QUEUED)
  uploadedAt DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  chunks     DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding  Unsupported("vector(768)")?

  @@map("document_chunks")
}

model CallLog {
  id          String     @id @default(cuid())
  studentName String
  phone       String
  duration    String
  status      CallStatus
  transcript  String?
  calledAt    DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@map("call_logs")
}

enum UserRole {
  ADMIN
  ADMISSION_OFFICER
  VIEWER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
}

enum LeadSource {
  CHAT
  VOICE
}

enum MessageRole {
  USER
  ASSISTANT
}

enum DocumentStatus {
  QUEUED
  PROCESSING
  PROCESSED
  FAILED
}

enum CallStatus {
  COMPLETED
  MISSED
  VOICEMAIL
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  role           String
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

